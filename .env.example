# Groq API key (preferred backend for LLM price estimation + NER labeling)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=

# Anthropic API key (fallback backend, used only if GROQ_API_KEY is unset)
ANTHROPIC_API_KEY=

# Optional: eBay App ID for official API (leave blank to use scraping)
EBAY_APP_ID=

# Optional: Discord webhook for deal alerts
DISCORD_WEBHOOK_URL=

# Optional: Telegram bot alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
SECRET_KEY=change-me-to-a-random-string

# Facebook Marketplace cookies file path (export from browser)
# See docs: export cookies as JSON using "Cookie Editor" browser extension
FACEBOOK_COOKIES_FILE=./facebook_cookies.json
