# Anthropic API key (required for LLM price estimation fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: eBay App ID for official API (leave blank to use scraping)
EBAY_APP_ID=

# Optional: Discord webhook for deal alerts
DISCORD_WEBHOOK_URL=

# Optional: Telegram bot alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
SECRET_KEY=change-me-to-a-random-string

# Facebook Marketplace cookies file path (export from browser)
# See docs: export cookies as JSON using "Cookie Editor" browser extension
FACEBOOK_COOKIES_FILE=./facebook_cookies.json
